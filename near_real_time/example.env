nrt_precomputed_dir=water_timeseries_argo_workflow/data/precomputed_nrt
nrt_pmtiles_output_dir=water_timeseries_argo_workflow/data/nrt_tiles
# Local scratch dir tippecanoe builds in before the archive is copied to nrt_pmtiles_output_dir
# (optional, defaults to /tmp/nrt_pmtiles_build)
nrt_pmtiles_build_dir=/tmp/nrt_pmtiles_build
drain_threshold=-0.25
nrt_poly_max_zoom=14